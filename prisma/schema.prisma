// Prisma schema for Precept (Supabase Postgres).
//
// READ-ONLY TYPED MIRROR of supabase/*.sql. This file is used ONLY to generate
// the typed Prisma Client (pnpm prisma generate). It is NOT used to provision
// the database — RLS policies, triggers, and the FK to auth.users cannot be
// modeled here, so `prisma db push` / `prisma migrate` would create tables with
// NO security layer. Always apply schema changes via the supabase/*.sql files
// in the Supabase Dashboard SQL Editor, then mirror the structural part here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Note: Supabase manages `auth.users`. We do NOT model it in Prisma to avoid
// Prisma trying to create/drop it. The FK columns (user_id uuid) remain.

model Profile {
  id        String   @id @db.Uuid
  name      String   @default("Athlete")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("profiles")
}

model UserStat {
  userId                   String   @id @db.Uuid @map("user_id")
  matchesPlayed            Int      @default(0) @map("matches_played")
  ballLossesUnderPressure  Int      @default(0) @map("ball_losses_under_pressure")
  successfulDribbles       Int      @default(0) @map("successful_dribbles")
  passAccuracy             Int      @default(0) @map("pass_accuracy")
  shotsOnTarget            Int      @default(0) @map("shots_on_target")
  avgFluidityScore         Int      @default(0) @map("avg_fluidity_score")
  practiceMinutes          Int      @default(0) @map("practice_minutes")
  skillsLearned            String[] @default([]) @map("skills_learned")
  bookmarkedSkills         String[] @default([]) @map("bookmarked_skills")
  achievements             Json     @default("[]") @map("achievements")
  currentStreak            Int      @default(0) @map("current_streak")
  longestStreak            Int      @default(0) @map("longest_streak")
  lastPracticeDate         String?  @map("last_practice_date")
  updatedAt                DateTime @default(now()) @map("updated_at")

  @@map("user_stats")
}

model PracticeSession {
  id             String
  userId         String   @db.Uuid @map("user_id")
  skillId        String   @map("skill_id")
  sport          String
  startTime      DateTime @map("start_time")
  endTime        DateTime? @map("end_time")
  fluidityScores Int[]    @default([]) @map("fluidity_scores")
  completed      Boolean  @default(false)
  notes          String?

  @@id([userId, id])
  @@map("practice_sessions")
}

model UserSetting {
  userId             String   @id @db.Uuid @map("user_id")
  hapticFeedback     Boolean  @default(true) @map("haptic_feedback")
  soundEffects       Boolean  @default(true) @map("sound_effects")
  practiceReminders  Boolean  @default(true) @map("practice_reminders")
  preferredDifficulty String  @default("all") @map("preferred_difficulty")
  preferredSport     String   @default("soccer") @map("preferred_sport")
  theme              String   @default("dark")
  weeklyGoalMinutes  Int      @default(60) @map("weekly_goal_minutes")
  updatedAt          DateTime @default(now()) @map("updated_at")

  @@map("user_settings")
}

model ProgramProgress {
  userId        String    @db.Uuid @map("user_id")
  programId     String    @map("program_id")
  completedSteps Int      @default(0) @map("completed_steps")
  totalSteps    Int       @default(0) @map("total_steps")
  startedAt     DateTime? @map("started_at")
  completedAt   DateTime? @map("completed_at")
  lastPracticed DateTime? @map("last_practiced")

  @@id([userId, programId])
  @@map("program_progress")
}

model GeneratedVideo {
  userId   String @db.Uuid @map("user_id")
  skillId  String @map("skill_id")
  videoUrl String @map("video_url")

  @@id([userId, skillId])
  @@map("generated_videos")
}

model LeaderboardEntry {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @map("session_token")
  name         String   @default("Anonymous")
  sport        String?
  clubId       String?  @map("club_id") @db.Uuid
  week         Int
  minutes      Int      @default(0)
  updatedAt    DateTime @default(now()) @map("updated_at")

  club Club? @relation(fields: [clubId], references: [id])

  @@unique([sessionToken, week])
  @@map("leaderboard_entries")
}

model Club {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  members       ClubMember[]
  leaderboardEntries LeaderboardEntry[]
  @@map("clubs")
}

model ClubMember {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clubId       String   @map("club_id") @db.Uuid
  sessionToken String   @map("session_token")
  name         String   @default("Anonymous")
  joinedAt     DateTime @default(now()) @map("joined_at")

  club Club @relation(fields: [clubId], references: [id])

  @@unique([clubId, sessionToken])
  @@map("club_members")
}

model PlayerCode {
  sessionToken String   @id @map("session_token")
  code         String   @unique
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("player_codes")
}

model Challenge {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  challengerToken String    @map("challenger_token")
  challengerName  String    @default("Anonymous") @map("challenger_name")
  opponentToken   String    @map("opponent_token")
  opponentName    String    @default("Anonymous") @map("opponent_name")
  sport           String?
  status          String    @default("pending")
  winnerToken     String?   @map("winner_token")
  createdAt       DateTime  @default(now()) @map("created_at")
  acceptedAt      DateTime? @map("accepted_at")
  resolvedAt      DateTime? @map("resolved_at")
  expiresAt       DateTime  @default(now()) @map("expires_at")

  @@index([challengerToken, status])
  @@index([opponentToken, status])
  @@map("challenges")
}

model DrillAssignment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  coachToken String   @map("coach_token")
  coachName  String   @default("Coach") @map("coach_name")
  skillId    String   @map("skill_id")
  skillName  String   @map("skill_name")
  sport      String?
  note       String?
  code       String   @unique
  createdAt  DateTime @default(now()) @map("created_at")

  claims AssignmentClaim[]
  @@index([coachToken, createdAt])
  @@map("drill_assignments")
}

model AssignmentClaim {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignmentId String    @map("assignment_id") @db.Uuid
  athleteToken String    @map("athlete_token")
  athleteName  String    @default("Anonymous") @map("athlete_name")
  completed    Boolean   @default(false)
  claimedAt    DateTime  @default(now()) @map("claimed_at")
  completedAt  DateTime? @map("completed_at")

  assignment DrillAssignment @relation(fields: [assignmentId], references: [id])

  @@unique([assignmentId, athleteToken])
  @@index([athleteToken])
  @@map("assignment_claims")
}
